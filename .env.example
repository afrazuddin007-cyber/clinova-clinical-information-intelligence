# Clinova Environment Variables
# Application
APP_ENV=development
DEBUG=True
PORT=8080

# Security & Authentication
JWT_SECRET=change_me_to_a_secure_random_32_byte_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# AI Engine (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database (Default: SQLite WAL, or PostgreSQL for Production)
DATABASE_URL=sqlite:///./clinova.db

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,image/png,image/jpeg
